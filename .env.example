# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# ── Empresa ──────────────────────────────────────────────────────────
# NIT de Paguro Corp (con o sin DV). Sin él no se procesan facturas,
# porque es lo que define si una factura es compra o venta.
PAGURO_NIT=

# ── Supabase (Project Settings → API) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Se usa para el procesamiento automático (no pasa por RLS).
SUPABASE_SERVICE_ROLE_KEY=

# ── IA ───────────────────────────────────────────────────────────────
# Proveedor y modelo configurables. La key sale de una organización de la
# Claude Console; el código solo depende de esta variable, así que moverla a
# una cuenta de la empresa es cambiar el valor y nada más.
AI_PROVIDER=anthropic
# Modelo para leer facturas. Para gastar menos créditos: claude-haiku-5-5
AI_MODEL=claude-sonnet-5-5
# Opcional: esfuerzo de razonamiento del modelo (low, medium, high). Por defecto: medium.
# AI_EFFORT=medium
ANTHROPIC_API_KEY=
# Opcional: precio por millón de tokens (USD) para estimar costo en los
# reportes de consumo. Si se dejan vacíos solo se registran los tokens.
AI_PRECIO_ENTRADA_MTOK=
AI_PRECIO_SALIDA_MTOK=

# ── Google Drive ─────────────────────────────────────────────────────
# ID de la carpeta raíz que se lee (hoy: la carpeta del año, "02_2026").
# Es lo que va después de /folders/ en la URL de la carpeta.
DRIVE_ROOT_FOLDER_ID=
# Cuenta de servicio (robot de solo lectura) con la que se comparte la carpeta.
# Sin llave: localmente se usa `gcloud auth application-default login` y se
# suplanta a esta cuenta (requiere el rol Service Account Token Creator).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Alternativa con llave (solo si la organización lo permite): JSON en una línea.
# Si se define, tiene prioridad sobre la suplantación.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Endpoints internos (tareas programadas externas, opcional) ───────
# Token compartido que se envía en el header x-contabilidad-token.
# Genera uno largo y aleatorio; no se usa si nadie llama los endpoints.
CONTABILIDAD_INTERNAL_TOKEN=

# ── Sincronización automática con el Drive (opcional) ────────────────
# "off" la apaga (útil al desarrollar contra la base de datos real).
# SYNC_AUTOMATICA=off
# Minutos entre revisiones del Drive (mínimo 5). Por defecto: 15.
# SYNC_INTERVALO_MINUTOS=15

# ── Solo para la CLI de Supabase (migraciones y respaldos) ───────────
# Contraseña de la base de datos (Project Settings → Database).
SUPABASE_DB_PASSWORD=

# ── Solo para las pruebas (npm run prueba:*) ─────────────────────────
# Dirección de la app que se prueba. Por defecto: http://localhost:3000
# URL_APP=http://localhost:3000
