{
  "name": "paguro-contabilidad",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "db:push": "supabase db push",
    "db:link": "supabase link",
    "db:tipos": "supabase gen types typescript --linked --schema contabilidad > src/modules/contabilidad/repo/tipos-db.ts",
    "acceso": "node --env-file=.env.local --import tsx src/modules/contabilidad/cli/acceso.ts",
    "verificar": "node --env-file=.env.local src/modules/contabilidad/cli/verificar-supabase.mjs",
    "respaldo": "node --env-file=.env.local src/modules/contabilidad/cli/respaldo.mts",
    "sync": "node --env-file=.env.local --import tsx src/modules/contabilidad/cli/sync.ts",
    "procesar": "node --env-file=.env.local --import tsx src/modules/contabilidad/cli/procesar.ts",
    "reintentar": "node --env-file=.env.local --import tsx src/modules/contabilidad/cli/reintentar.ts",
    "reprocesar": "node --env-file=.env.local --import tsx src/modules/contabilidad/cli/reprocesar.ts",
    "ver-facturas": "node --env-file=.env.local --import tsx src/modules/contabilidad/cli/ver-facturas.ts",
    "resumen": "node --env-file=.env.local --import tsx src/modules/contabilidad/cli/resumen.ts",
    "probar-drive": "node --env-file=.env.local --import tsx src/modules/contabilidad/cli/probar-drive.ts",
    "probar-ia": "node --env-file=.env.local --import tsx src/modules/contabilidad/cli/probar-ia.ts",
    "manual:pdf": "node --import tsx scripts/manual-pdf.mts",
    "tecnico:pdf": "node --import tsx scripts/manual-pdf.mts docs/tecnico/documento-tecnico.html docs/tecnico/Documento-tecnico-Paguro-ERP.pdf \"Paguro ERP · Documento técnico\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "google-auth-library": "^11.3.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
